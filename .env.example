# ============================================
# NOVA OS Environment Variables
# Copy this file to .env and fill in your values
# ============================================

# Application
NODE_ENV=development
APP_NAME=NOVA OS

# PostgreSQL 16 Configuration (used by docker-compose & Prisma)
POSTGRES_USER=nova
POSTGRES_PASSWORD=replace-with-a-strong-password
POSTGRES_DB=nova_os
DATABASE_URL=postgresql://nova:replace-with-a-strong-password@localhost:5432/nova_os?schema=public

# Redis 7 Configuration
REDIS_URL=redis://localhost:6379

# API Configuration
API_PORT=3003
API_PREFIX=api

# Next.js Web
WEB_PORT=3004
NEXT_PUBLIC_API_URL=http://localhost:3003/api

# JWT Secret (change in production)
JWT_SECRET=your-jwt-secret-change-this-in-production

# AI Configuration (optional)
AI_PROVIDER=
AI_API_KEY=
AI_BASE_URL=
